    \"dtype\": \"category\",\n        \"num_unique_values\": 2,\n        \"samples\": [\n          \"MONITOR\",\n          \"REFRESH_REVIEW\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"days_since_last_update\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 42,\n        \"min\": 1,\n        \"max\": 373,\n        \"num_unique_values\": 57,\n        \"samples\": [\n          104,\n          193\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"impressions_90d\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 16838,\n        \"min\": 1,\n        \"max\": 517715,\n        \"num_unique_values\": 9438,\n        \"samples\": [\n          26932,\n          3434\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"ctr\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 3.2791619679928767,\n        \"min\": 0.0,\n        \"max\": 100.0,\n        \"num_unique_values\": 401,\n        \"samples\": [\n          5.0,\n          3.33\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"avg_position\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 15.216790472785638,\n        \"min\": 0.0,\n        \"max\": 245.0,\n        \"num_unique_values\": 869,\n        \"samples\": [\n          49.6,\n          6.3\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
