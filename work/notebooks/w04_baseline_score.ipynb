        "# This cell is for CODE (numbers, a query, a check).\n",
        "# Write your text answer in the cell ABOVE this one — typing sentences here breaks Run All.\n",
        "# ---------------------------------------------------------\n",
        "# Identify weak top-10 picks for auditing only.\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "top10_audit = top10.merge(\n",
        "    df[\n",
        "        [\n",
        "            \"content_id\",\n",
        "            \"is_declining_label\",\n",
        "        ]\n",
        "    ],\n",
        "    on=\"content_id\",\n",
        "    how=\"left\",\n",
        ")\n",
        "\n",
        "weak_picks = top10_audit[\n",
        "    top10_audit[\"is_declining_label\"] == 0\n",
        "].copy()\n",
        "\n",
        "print(\n",
        "    \"Weak picks in the top 10:\",\n",
        "    len(weak_picks),\n",
        ")\n",
        "\n",
        "if weak_picks.empty:\n",
        "    print(\n",
        "        \"No weak picks were found under this evaluation label.\"\n",
        "    )\n",
        "else:\n",
        "    display(\n",
        "        weak_picks[\n",
        "            [\n",
        "                \"baseline_rank\",\n",
        "                \"content_id\",\n",
        "                \"action_label\",\n",
        "                \"days_since_last_update\",\n",
        "                \"impressions_90d\",\n",
        "                \"ctr\",\n",
        "                \"avg_position\",\n",
        "            ]\n",
        "        ]\n",
        "    )\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# Confirm no leakage entered the score.\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "SCORE_INPUTS = {\n",
        "    \"days_since_last_update\",\n",
        "    \"impressions_90d\",\n",
        "}\n",
        "\n",
        "FORBIDDEN_INPUTS = {\n",
        "    \"trend_direction\",\n",
        "    \"trend_pct\",\n",
        "    \"is_declining_label\",\n",
        "    \"impressions_last_30d\",\n",
        "    \"impressions_prev_30d\",\n",
        "    \"clicks_last_30d\",\n",
        "    \"clicks_prev_30d\",\n",
        "}\n",
        "\n",
        "assert SCORE_INPUTS.isdisjoint(\n",
        "    FORBIDDEN_INPUTS\n",
        ")\n",
        "\n",
        "assert not (\n",
        "    {\n",
        "        \"trend_direction\",\n",
        "        \"trend_pct\",\n",
        "        \"is_declining_label\",\n",
        "    }\n",
        "    & set(queue.columns)\n",
        ")\n",
