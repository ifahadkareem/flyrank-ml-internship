      "source": [
        "# This cell is for CODE (numbers, a query, a check).\n",
        "# Write your text answer in the cell ABOVE this one — typing sentences here breaks Run All.\n",
        "from pathlib import Path\n",
        "import json\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# Encode one transparent rule\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "eligible_for_review = (\n",
        "    (df[\"days_since_last_update\"] >= 91)\n",
        "    & (df[\"impressions_90d\"] >= 100)\n",
        ")\n",
        "\n",
        "# Visibility percentile is calculated only from impressions.\n",
        "df[\"visibility_percentile\"] = (\n",
        "    df[\"impressions_90d\"]\n",
        "    .rank(method=\"average\", pct=True)\n",
        ")\n",
        "\n",
        "# Eligible pages receive scores from 50 to 100.\n",
        "# Non-eligible pages receive 0.\n",
        "df[\"baseline_action_score\"] = np.where(\n",
        "    eligible_for_review,\n",
        "    50 + 50 * df[\"visibility_percentile\"],\n",
        "    0,\n",
        ").round(3)\n",
        "\n",
        "# Exactly one reason code per row.\n",
        "df[\"reason_code\"] = np.where(\n",
        "    eligible_for_review,\n",
        "    \"stale_visible_page\",\n",
        "    \"below_refresh_threshold\",\n",
        ")\n",
        "\n",
        "df[\"action_label\"] = np.where(\n",
        "    eligible_for_review,\n",
        "    \"REFRESH_REVIEW\",\n",
        "    \"MONITOR\",\n",
        ")\n",
        "\n",
        "df[\"baseline_rank\"] = (\n",
        "    df[\"baseline_action_score\"]\n",
        "    .rank(\n",
        "        method=\"first\",\n",
        "        ascending=False,\n",
        "    )\n",
        "    .astype(int)\n",
        ")\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# Create the public-safe ranked queue.\n",
        "# Do not include the label or trend fields.\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "QUEUE_COLUMNS = [\n",
        "    \"content_id\",\n",
        "    \"client_id\",\n",
        "    \"baseline_rank\",\n",
        "    \"baseline_action_score\",\n",
        "    \"reason_code\",\n",
        "    \"action_label\",\n",
        "    \"days_since_last_update\",\n",
        "    \"impressions_90d\",\n",
        "    \"ctr\",\n",
        "    \"avg_position\",\n",
        "]\n",
        "\n",
        "queue = (\n",
        "    df[QUEUE_COLUMNS]\n",
        "    .sort_values(\"baseline_rank\")\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# Write the required CSV\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "OUTPUT_DIR = Path(\"work/outputs\")\n",
        "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "CSV_PATH = (\n",
        "    OUTPUT_DIR\n",
        "    / \"baseline_action_score.csv\"\n",
        ")\n",
        "\n",
        "queue.to_csv(\n",
        "    CSV_PATH,\n",
        "    index=False,\n",
        ")\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# Evaluate the baseline without adding the label to the CSV.\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "evaluation = (\n",
        "    queue[\n",
        "        [\n",
        "            \"content_id\",\n",
        "            \"baseline_rank\",\n",
        "        ]\n",
        "    ]\n",
        "    .merge(\n",
        "        df[\n",
        "            [\n",
        "                \"content_id\",\n",
        "                \"is_declining_label\",\n",
        "            ]\n",
        "        ],\n",
        "        on=\"content_id\",\n",
        "        how=\"left\",\n",
        "    )\n",
        "    .sort_values(\"baseline_rank\")\n",
        ")\n",
        "\n",
        "base_rate = df[\"is_declining_label\"].mean()\n",
        "\n",
        "precision_at_10 = (\n",
        "    evaluation\n",
        "    .head(10)[\"is_declining_label\"]\n",
        "    .mean()\n",
        ")\n",
        "\n",
        "eligible_count = int(\n",
        "    eligible_for_review.sum()\n",
        ")\n",
        "\n",
        "metrics = {\n",
        "    \"dataset_rows\": int(len(df)),\n",
        "    \"eligible_rows\": eligible_count,\n",
        "    \"base_rate\": round(\n",
        "        float(base_rate),\n",
        "        4,\n",
        "    ),\n",
        "    \"precision_at_10\": round(\n",
        "        float(precision_at_10),\n",
        "        4,\n",
        "    ),\n",
        "    \"score_inputs\": [\n",
        "        \"days_since_last_update\",\n",
        "        \"impressions_90d\",\n",
        "    ],\n",
        "    \"reason_code\": \"stale_visible_page\",\n",
        "    \"action_label\": \"REFRESH_REVIEW\",\n",
        "}\n",
        "\n",
        "METRICS_PATH = (\n",
        "    OUTPUT_DIR\n",
        "    / \"w04_baseline_metrics.json\"\n",
        ")\n",
        "\n",
        "METRICS_PATH.write_text(\n",
        "    json.dumps(\n",
        "        metrics,\n",
        "        indent=2,\n",
        "    ),\n",
        "    encoding=\"utf-8\",\n",
        ")\n",
        "\n",
        "print(\"Queue rows:\", len(queue))\n",
        "print(\"Eligible refresh-review rows:\", eligible_count)\n",
        "print(f\"Observed base rate: {base_rate:.3f}\")\n",
        "print(f\"Precision@10: {precision_at_10:.3f}\")\n",
        "print(\"CSV written to:\", CSV_PATH)\n",
        "print(\"Metrics written to:\", METRICS_PATH)\n",
        "\n",
        "queue.head(10)\n"
      ],
