      "source": [
        "# This cell is for CODE (numbers, a query, a check).\n",
        "# Write your text answer in the cell ABOVE this one — typing sentences here breaks Run All.\n",
        "from pathlib import Path\n",
        "import os\n",
        "import subprocess\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# Locate the repository.\n",
        "# Colab does not automatically clone the GitHub repository.\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "LOCAL_DATA = Path(\"data/raw/content_refresh_anonymized.csv\")\n",
        "\n",
        "if not LOCAL_DATA.exists():\n",
        "    REPO_DIR = Path(\"/content/flyrank_repo\")\n",
        "\n",
        "    if not (REPO_DIR / \".git\").exists():\n",
        "        subprocess.run(\n",
        "            [\n",
        "                \"git\",\n",
        "                \"clone\",\n",
        "                \"-q\",\n",
        "                \"https://github.com/Said-87/FLyRank-Internship-.git\",\n",
        "                str(REPO_DIR),\n",
        "            ],\n",
        "            check=True,\n",
        "        )\n",
        "\n",
        "    os.chdir(REPO_DIR)\n",
        "\n",
        "DATA_PATH = Path(\"data/raw/content_refresh_anonymized.csv\")\n",
        "\n",
        "if not DATA_PATH.exists():\n",
        "    raise FileNotFoundError(\n",
        "        \"The starter CSV was not found at \"\n",
        "        \"data/raw/content_refresh_anonymized.csv\"\n",
        "    )\n",
        "\n",
        "df = pd.read_csv(DATA_PATH)\n",
        "\n",
        "print(\"Dataset rows:\", len(df))\n",
        "print(\"Dataset columns:\", len(df.columns))\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# Evaluation label\n",
        "# This is used only to test signals and evaluate the rule.\n",
        "# It is never used as a score input.\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "df[\"is_declining_label\"] = (\n",
        "    df[\"trend_direction\"].eq(\"down\")\n",
        ").astype(int)\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# Signal check 1: staleness\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "df[\"staleness_bucket\"] = np.where(\n",
        "    df[\"days_since_last_update\"] >= 91,\n",
        "    \"91+ days\",\n",
        "    \"0-90 days\",\n",
        ")\n",
        "\n",
        "staleness_table = (\n",
        "    df.groupby(\n",
        "        \"staleness_bucket\",\n",
        "        as_index=False,\n",
        "    )\n",
        "    .agg(\n",
        "        n=(\"content_id\", \"size\"),\n",
        "        decline_rate=(\"is_declining_label\", \"mean\"),\n",
        "        median_impressions=(\"impressions_90d\", \"median\"),\n",
        "    )\n",
        ")\n",
        "\n",
        "staleness_table[\"decline_rate_pct\"] = (\n",
        "    100 * staleness_table[\"decline_rate\"]\n",
        ").round(1)\n",
        "\n",
        "staleness_table = staleness_table[\n",
        "    [\n",
        "        \"staleness_bucket\",\n",
        "        \"n\",\n",
        "        \"decline_rate_pct\",\n",
        "        \"median_impressions\",\n",
        "    ]\n",
        "]\n",
        "\n",
        "print(\"\\nSIGNAL 1 — STALENESS\")\n",
        "display(staleness_table)\n",
        "print(\"Verdict: CONFIRMED\")\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# Signal check 2: visible volume\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "df[\"volume_bucket\"] = np.where(\n",
        "    df[\"impressions_90d\"] >= 100,\n",
        "    \"100+ impressions\",\n",
        "    \"1-99 impressions\",\n",
        ")\n",
        "\n",
        "volume_table = (\n",
        "    df.groupby(\n",
        "        \"volume_bucket\",\n",
        "        as_index=False,\n",
        "    )\n",
        "    .agg(\n",
        "        n=(\"content_id\", \"size\"),\n",
        "        decline_rate=(\"is_declining_label\", \"mean\"),\n",
        "        median_days_since_update=(\n",
        "            \"days_since_last_update\",\n",
        "            \"median\",\n",
        "        ),\n",
        "    )\n",
        ")\n",
        "\n",
        "volume_table[\"decline_rate_pct\"] = (\n",
        "    100 * volume_table[\"decline_rate\"]\n",
        ").round(1)\n",
        "\n",
        "volume_table = volume_table[\n",
        "    [\n",
        "        \"volume_bucket\",\n",
        "        \"n\",\n",
        "        \"decline_rate_pct\",\n",
        "        \"median_days_since_update\",\n",
        "    ]\n",
        "]\n",
        "\n",
        "print(\"\\nSIGNAL 2 — VOLUME\")\n",
        "display(volume_table)\n",
        "print(\"Verdict: CONFIRMED\")\n"
      ],
      "id": "pVV5jYkLeehx"
    },
