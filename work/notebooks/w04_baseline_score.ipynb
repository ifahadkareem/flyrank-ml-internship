      "source": [
        "# This cell is for CODE (numbers, a query, a check).\n",
        "# Write your text answer in the cell ABOVE this one — typing sentences here breaks Run All.\n",
        "def what_would_make_it_wrong(row):\n",
        "    \"\"\"\n",
        "    Produce a skeptical, row-specific challenge.\n",
        "    CTR values are percentages:\n",
        "    0.20 means 0.20%, not 20%.\n",
        "    \"\"\"\n",
        "\n",
        "    if (\n",
        "        row[\"avg_position\"] <= 10\n",
        "        and row[\"ctr\"] < 0.20\n",
        "    ):\n",
        "        return (\n",
        "            \"The page may need a title or snippet CTR fix \"\n",
        "            \"rather than a full content refresh.\"\n",
        "        )\n",
        "\n",
        "    if row[\"avg_position\"] > 20:\n",
        "        return (\n",
        "            \"Weak ranking may come from authority or intent \"\n",
        "            \"mismatch, so refreshing content alone may not help.\"\n",
        "        )\n",
        "\n",
        "    if row[\"ctr\"] >= 0.50:\n",
        "        return (\n",
        "            \"CTR is already relatively strong, so age alone \"\n",
        "            \"may overstate the need for a refresh.\"\n",
        "        )\n",
        "\n",
        "    return (\n",
        "        \"Seasonality, a campaign, or still-current information \"\n",
        "        \"could make the refresh unnecessary.\"\n",
        "    )\n",
        "\n",
        "\n",
        "top10 = queue.head(10).copy()\n",
        "\n",
        "top10[\"review_line\"] = top10.apply(\n",
        "    lambda row: (\n",
        "        f\"{row['action_label']} — \"\n",
        "        f\"{int(row['days_since_last_update'])} days since update \"\n",
        "        f\"and {int(row['impressions_90d']):,} impressions. \"\n",
        "        f\"Why: {row['reason_code']}. \"\n",
        "        f\"What would make it wrong: \"\n",
        "        f\"{what_would_make_it_wrong(row)}\"\n",
        "    ),\n",
        "    axis=1,\n",
        ")\n",
        "\n",
        "print(\"TOP-10 HUMAN REVIEW\\n\")\n",
        "\n",
        "for review_number, review_line in enumerate(\n",
        "    top10[\"review_line\"],\n",
        "    start=1,\n",
        "):\n",
        "    print(f\"{review_number}. {review_line}\")\n"
      ],
